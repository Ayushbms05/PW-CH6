# AeroHaven Gemini API Key Configuration
# Get your Gemini API key from https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Model Fallback Chains (Comma-separated, order of priority)
GEMINI_MODEL_CHAIN_LIGHT=gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-2.5-flash,gemini-flash-lite-latest
GEMINI_MODEL_CHAIN_HEAVY=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-flash-lite-latest

# Performance & Reliability Knobs
GEMINI_TIMEOUT_SECONDS=35
GEMINI_MIN_INTERVAL_SECONDS=1.0
